HA_TOKEN=

# Production: Mosquitto/Zigbee2MQTT/ESP32 sensors
SENTERO_MQTT_USERNAME=
SENTERO_MQTT_PASSWORD=
# Docker/LAN exposure.
# Use the Mini-PC LAN IP for LAN-only access, e.g. 192.168.178.20.
# Do not forward this port from the router to the internet.
SENTERO_BIND_ADDRESS=0.0.0.0
SENTERO_TIMEZONE=Europe/Berlin
SENTERO_DAILY_SUMMARY_TIME=20:00

# MQTT should stay local unless ESP32 sensors need LAN MQTT access.
# For ESP32 sensors, set this to the Mini-PC LAN IP.
SENTERO_MQTT_BIND_ADDRESS=127.0.0.1

# Presence sensor onboarding transport.
# Default: zigbee. Set wifi_esphome to use the existing ESP32/WLAN provisioning flow.
SENTERO_PRESENCE_SENSOR_TRANSPORT=zigbee

# Optional external AAL edge. Use a real DNS name for Caddy TLS,
# e.g. SENTERO_AAL_SITE=aal.example.org. Default is local test port :8088.
SENTERO_AAL_SITE=:8088
SENTERO_AAL_HTTP_BIND_ADDRESS=0.0.0.0
SENTERO_AAL_HTTPS_BIND_ADDRESS=0.0.0.0
SENTERO_AAL_TEST_BIND_ADDRESS=127.0.0.1

SENTERO_BOX_SETUP_MODE=disabled
SENTERO_MQTT_USERNAME=
SENTERO_MQTT_PASSWORD=
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=
ANTHROPIC_API_KEY=
SENTERO_ESP32_DEVICE_TOKEN=
