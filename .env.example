# Sensor pipeline: MQTT only.
# Zigbee devices are received through Zigbee2MQTT; ESP32 devices use MQTT topics.
SENTERO_MQTT_HOST=192.168.178.159
SENTERO_MQTT_PORT=1883
SENTERO_MQTT_USERNAME=
SENTERO_MQTT_PASSWORD=

# Docker/LAN exposure.
# Use the Mini-PC LAN IP for LAN-only access, e.g. 192.168.178.20.
# Do not forward this port from the router to the internet.
SENTERO_BIND_ADDRESS=0.0.0.0
SENTERO_TIMEZONE=Europe/Berlin
SENTERO_DAILY_SUMMARY_TIME=20:00

# Presence sensor onboarding transport.
# Default: zigbee. Set wifi_esphome to use the existing ESP32/WLAN provisioning flow.
SENTERO_PRESENCE_SENSOR_TRANSPORT=zigbee

SENTERO_BOX_SETUP_MODE=disabled
GEMINI_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=
ANTHROPIC_API_KEY=
SENTERO_ESP32_DEVICE_TOKEN=

