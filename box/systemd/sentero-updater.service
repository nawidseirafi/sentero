[Unit]
Description=Sentero privileged host updater
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/sentero/box/sentero-updater/sentero_updater.py
Restart=on-failure
RestartSec=2
RuntimeDirectory=sentero-updater
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
