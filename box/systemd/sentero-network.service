[Unit]
Description=Sentero privileged host network agent
After=NetworkManager.service
Requires=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/sentero/box/sentero-network/sentero_network.py
Restart=on-failure
RestartSec=2
RuntimeDirectory=sentero-network
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
