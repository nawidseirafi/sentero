[Unit]
Description=Sentero Box Docker Compose stack
Requires=docker.service sentero-network.service
After=docker.service NetworkManager.service sentero-network.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/sentero/box
ExecStart=/opt/sentero/box/scripts/start-box.sh
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
