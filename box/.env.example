COMPOSE_PROJECT_NAME=sentero
# first-install.sh sets this to "zigbee" only when an adapter is present.
COMPOSE_PROFILES=
SENTERO_MQTT_HOST=mosquitto
SENTERO_MQTT_PORT=1883
SENTERO_MQTT_USERNAME=
SENTERO_MQTT_PASSWORD=

SENTERO_BIND_ADDRESS=0.0.0.0
MQTT_BIND_ADDRESS=127.0.0.1

SENTERO_TIMEZONE=Europe/Berlin
SENTERO_DAILY_SUMMARY_TIME=20:00

# Docker image repository and installed application version.
# The release builder replaces SENTERO_VERSION for customer packages.
SENTERO_IMAGE=sentero/app
SENTERO_VERSION=dev

SENTERO_UPDATE_CHANNEL=stable
SENTERO_UPDATE_MODE=appliance
SENTERO_UPDATE_BASE_URL=https://sentero.de/sentero
SENTERO_UPDATE_MANIFEST_URL=
SENTERO_UPDATER_SOCKET=/run/sentero-updater/updater.sock

SENTERO_PRESENCE_SENSOR_TRANSPORT=zigbee

SENTERO_BOX_SETUP_MODE=auto
SENTERO_BOX_HOSTNAME=sentero
SENTERO_NETWORK_SOCKET=/run/sentero-network/network.sock

SENTERO_LLM_PROVIDER=ollama
SENTERO_LLM_BASE_URL=http://ollama:11434
SENTERO_LLM_MODEL=qwen2.5:3b
GEMINI_API_KEY=

# Zigbee adapter. first-install.sh auto-detects ZIGBEE_ADAPTER_HOST.
ZIGBEE_ADAPTER_HOST=
ZIGBEE_ADAPTER_CONTAINER=/dev/ttyACM0
ZIGBEE_ADAPTER_TYPE=ember
ZIGBEE2MQTT_TOPIC_PREFIX=zigbee2mqtt

# External DNS fallbacks used by the Sentero application container.
SENTERO_DNS_PRIMARY=1.1.1.1
SENTERO_DNS_SECONDARY=8.8.8.8
