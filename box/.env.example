COMPOSE_PROJECT_NAME=sentero

# Sentero image. For a local source checkout, first-install.sh builds this tag.
SENTERO_IMAGE=sentero/app
SENTERO_VERSION=dev
SENTERO_HTTP_BIND=0.0.0.0
SENTERO_HTTP_PORT=8080
SENTERO_TIMEZONE=Europe/Berlin
SENTERO_DAILY_SUMMARY_TIME=20:00
SENTERO_BOX_SETUP_MODE=disabled

# Update server used by Sentero and by the host updater.
SENTERO_UPDATE_CHANNEL=stable
SENTERO_UPDATE_MODE=appliance
SENTERO_UPDATE_BASE_URL=https://seirafi.de/robotersteve/sentero
SENTERO_UPDATE_MANIFEST_URL=
SENTERO_UPDATER_SOCKET=/run/sentero-updater/updater.sock

# MQTT. Use a strong password before first-install.sh.
MQTT_BIND_ADDRESS=0.0.0.0
MQTT_PORT=1883
SENTERO_MQTT_HOST=mosquitto
SENTERO_MQTT_PORT=1883
SENTERO_MQTT_USERNAME=sentero
SENTERO_MQTT_PASSWORD=change-me
ZIGBEE2MQTT_TOPIC_PREFIX=zigbee2mqtt
SENTERO_ZIGBEE2MQTT_TOPIC_PREFIX=zigbee2mqtt

# Zigbee coordinator. Always use /dev/serial/by-id/...
ZIGBEE_ADAPTER_HOST=/dev/serial/by-id/usb-change-me
ZIGBEE_ADAPTER_CONTAINER=/dev/ttyACM0
# Sonoff ZBDongle-P: zstack. Sonoff ZBDongle-E: ember.
ZIGBEE_ADAPTER_TYPE=zstack

# Local LLM.
SENTERO_LLM_PROVIDER=ollama
SENTERO_LLM_BASE_URL=http://ollama:11434
SENTERO_LLM_MODEL=qwen2.5:3b

# Optional API keys. Leave empty for fully local Ollama/rule-based operation.
GEMINI_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=
ANTHROPIC_API_KEY=
SENTERO_ESP32_DEVICE_TOKEN=

# Optional external AAL edge proxy. Leave empty to keep caddy disabled.
SENTERO_AAL_SITE=
